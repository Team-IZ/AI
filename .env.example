APP_ENV=local
INTERNAL_API_KEY=

# 루트 로거 레벨. INFO면 단계별 진행(어느 문제·어느 축·몇 초)이 찍힌다.
# ⚠️ uvicorn --log-level은 uvicorn 자기 로거만 건드린다 — 이 값이 app.* 로그를 정한다.
LOG_LEVEL=INFO

# 분석 엔진. stub = 가짜 응답, real = 실물(T7 이후)
ENGINE_MODE=stub

# NVIDIA Build API 키. NvidiaKeyPool이 NVIDIA_API_KEY_<N> 패턴을 자동 수집한다
# (개수·순서 무관). 무료 티어는 (키, 모델) 쌍당 분당 40회라 N개면 모델당 N x 40.
#
# 값은 절대 커밋하지 않는다. 이 파일은 "빈 값만" 커밋한다.
# 실제 값은 .env(gitignore)에만 넣고 로그·에러 메시지·이슈에도 옮기지 않는다.
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
NVIDIA_API_KEY_5=
NVIDIA_API_KEY_6=
NVIDIA_API_KEY_7=
NVIDIA_API_KEY_8=

# 용도별 기본 모델. 요청에 modelCode가 오면 그쪽이 우선한다(operator 권한).
# 팀원 실측 기준이고 언제든 바뀐다. 나중에 프론트에서 고르게 될 수도 있다.
MODEL_CODE_ANALYSIS=nvidia/nemotron-3-ultra-550b-a55b
# 2026-08-07: deepseek-v4-flash가 deprecate 통보를 받아 교체됐다.
MODEL_CODE_SESSION=minimaxai/minimax-m3
MODEL_CODE_CURRICULUM=minimaxai/minimax-m3

# analysis-inputs 분리(D1/D2/D3, 2026-08-06). app/config.py 주석 참고.
ANALYSIS_INPUT_CLONE_TIMEOUT_S=10
GIT_HISTORY_BUDGET_S=3
GIT_HISTORY_SINCE_DAYS=180
GIT_HISTORY_MAX_COMMITS=500
ALLOWED_REPO_HOSTS=github.com,www.github.com
# 비우면(기본) presigned URL 다운로드를 전부 거부한다(fail-closed) — 백엔드가
# 실제 스토리지 호스트를 알려주면 채운다.
ALLOWED_STORAGE_HOSTS=
ZIP_REQUIRE_GIT_LOG=false
