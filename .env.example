APP_ENV=local
INTERNAL_API_KEY=

# 분석 엔진. stub = 가짜 응답, real = 실물(T7 이후)
ENGINE_MODE=stub

# NVIDIA Build API 키. NvidiaKeyPool이 NVIDIA_API_KEY_<N> 패턴을 자동 수집한다
# (개수·순서 무관). 무료 티어는 (키, 모델) 쌍당 분당 40회라 N개면 모델당 N x 40.
#
# 값은 절대 커밋하지 않는다. 이 파일은 "빈 값만" 커밋한다.
# 실제 값은 .env(gitignore)에만 넣고 로그·에러 메시지·이슈에도 옮기지 않는다.
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
NVIDIA_API_KEY_5=
NVIDIA_API_KEY_6=
NVIDIA_API_KEY_7=
NVIDIA_API_KEY_8=

# 요청에 modelCode가 없을 때 쓸 기본 모델. 모델 선택 권한은 operator에게 있다
DEFAULT_MODEL_CODE=
