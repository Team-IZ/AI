# 운영 모드: standalone(AI 단독 테스트, Supabase 대역) | integrated(Spring 경유, 저장 없음)
APP_MODE=integrated

# [B1 확정] Spring↔FastAPI **실제 통합용** 공유 API 키. Spring이 X-Internal-Key
# 헤더로 전송한다. 실제 값은 아직 미정이므로 빈 채로 둔다(= 검증 비활성, 기존 동작).
# integrated 배포에서는 반드시 설정할 것. **비밀 값이며 절대 커밋하지 말 것.**
#
# 목업 전용 개발 키와 혼동하지 말 것 — 둘은 별개이고 공존한다:
#   - INTERNAL_API_KEY (여기)      : 비밀. 실제 Spring↔FastAPI 통합용. integrated에서 강제.
#   - STANDALONE_DEV_API_KEY       : 공개 상수. 목업 페이지 전용. app/config.py에 하드코딩돼
#                                    있고 환경변수로 바꾸지 않는다(목업이 같은 값을 갖고 있어서).
# 개발 키는 APP_MODE=standalone일 때만 통한다. integrated에서는 실제 키 설정 여부와
# 무관하게 거부되므로, 값이 공개돼 있어도 프로덕션 인증을 우회할 수 없다.
# 이 구조는 "standalone = 로컬 개발 도구 전용 모드"라는 전제 위에 성립한다 —
# standalone 서버를 외부에 노출하지 말 것.
INTERNAL_API_KEY=

# NVIDIA LLM API 키 (Phase 3+에서 필요. 절대 커밋하지 말 것)
NVIDIA_API_KEY=

# Supabase (standalone 모드 전용, Phase 5)
SUPABASE_URL=
SUPABASE_KEY=

# [B6 확정] 운영 파라미터 — FastAPI가 스스로 지키는 값만 둔다.
# job 폴링 주기(3s)·최대 대기(15분)는 호출자 Spring의 몫이라 여기 없음(명세 §2).
LLM_TIMEOUT_SEC=600
ANSWER_TIMEOUT_SEC=120
CALLBACK_RETRY_MAX=3

# [§3.3 확정] 코드 원문 무저장 — 임시 작업공간에서만 유지 후 삭제.
# 비워두면 OS 임시 디렉터리 하위를 쓴다. TTL 수치는 명세 미확정(잠정 24h).
# WORKSPACE_DIR=
WORKSPACE_TTL_SEC=86400

# CORS 허용 오리진 (쉼표 구분) — standalone 모드에서만 적용된다.
# integrated에서는 호출자가 Spring뿐이라 CORS 미들웨어를 붙이지 않는다(명세 §1).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
