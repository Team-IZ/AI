# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
dist/

# Env — .env.example만 커밋한다(값은 전부 비어 있어야 함)
.env
.env.*
!.env.example

# D9 (2026-07-30): NVIDIA 키풀 로테이션은 로컬 테스트 편의용일 뿐, 실배포는
# 단일 키(40 rpm)를 쓴다 -- 이 디렉터리/파일은 코드에 절대 실리지 않는다.
scripts/local/
**/nvidia_key_pool.py

# 분석 작업공간 (명세 §3.3: 코드 원문 무저장)
# 기본값은 OS 임시 디렉터리라 보통 여기 안 생기지만, WORKSPACE_DIR을 레포 안으로
# 잡으면 clone된 레포·수백 MB ZIP이 통째로 스테이징된다. 방어용.
workspace/
uploads/
*.zip

# Test / runtime artifacts
.pytest_cache/
feedback_log.jsonl
*.log

# 린터·타입체커 캐시
.ruff_cache/
.mypy_cache/

# 커버리지 산출물
.coverage
htmlcov/

# 로컬 DB 파일 — Phase 5에서 standalone 저장 계층을 붙이면 생길 수 있다. 사전 방어.
*.sqlite3
*.db

# 구 구현 참고용 로컬 사본 (FastAPI 재구축 중 모듈화 참고).
# 이력에는 남아 있으므로 필요하면 `git show <commit>:app/...`로 꺼낸다.
_legacy/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Cloudflare Worker+Container 배포 (D1, 2026-07-31)
# package-lock.json은 재현성을 위해 커밋한다(gitignore 대상 아님) -- 팀원 누구든
# `npm ci`로 같은 wrangler/containers 버전을 받게 하기 위함.
node_modules/
.wrangler/

# Claude Code
.claude/
CLAUDE.md

# D-handoff (2026-07-31): 세션 간 컨텍스트 hand-off 메모 -- 사용자 요청으로 로컬 전용,
# 팀 저장소에는 안 올린다(우발적 배포 상태 스냅샷·미커밋 diff 목록 등 팀 공유용이
# 아닌 개인 작업 메모라 커밋 대상에서 제외).
#   WHY: 이 문서는 특정 시점 스냅샷이라 금방 stale해짐 -- 커밋해서 팀 저장소에
#     남기면 나중에 "이미 고쳐진 버그"를 다시 최신 정보인 것처럼 읽을 위험이 있다.
#   COST: 다른 사람/다른 머신에서 이 파일을 못 본다 -- 팀에 공유하려면 이 gitignore
#     예외 처리 후 별도로 커밋해야 함.
#   EXIT: 팀과 공유할 가치가 생기면 이 줄 제거하고 커밋.
docs/code-importance-map/HANDOFF.md
