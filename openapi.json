  "components": {
    "schemas": {
      "AnalysisAccepted": {
        "properties": {
          "jobId": {
            "type": "string",
            "title": "Jobid"
          },
          "status": {
            "type": "string",
            "const": "QUEUED",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "jobId",
          "status"
        ],
        "title": "AnalysisAccepted",
        "description": "202 응답. 점수만 알리고 결과는 폴링으로 가져감 "
      },
      "AnalysisJobStatus": {
        "properties": {
          "jobId": {
            "type": "string",
            "title": "Jobid"
          },
          "attemptId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attemptid"
          },
          "submissionId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Submissionid"
          },
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "SUCCEEDED",
              "PARTIAL",
              "FAILED"
            ],
            "title": "Status"
          },
          "failureReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failurereason",
            "description": "FAILED일 때만 채워진다"
          },
          "startedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Startedat"
          },
          "completedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completedat"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisResult"
              },
              {
                "type": "null"
              }
            ],
            "description": "SUCCEEDED·PARTIAL일 때만"
          },
          "aiUsage": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Aiusage"
          }
        },
        "type": "object",
        "required": [
          "jobId",
          "status"
        ],
        "title": "AnalysisJobStatus",
        "description": "GET /analyses/{jobId} 응답.\n\nstatus 값은 DB analysis_job.status의 CHECK 제약과 같다(PLAN §3).\nANALYZING·READY는 다른 테이블의 값이라 여기 쓰면 Spring INSERT가 깨진다."
      },
      "AnalysisResult": {
        "properties": {
          "snapshotId": {
            "type": "string",
            "title": "Snapshotid",
            "description": "Spring code_snapshot 행의 키"
          },
          "snapshotMeta": {
            "$ref": "#/components/schemas/SnapshotMeta"
          },
          "appliedScope": {
            "type": "string",
            "enum": [
              "TOTAL",
              "OWN_COMMIT"
            ],
            "title": "Appliedscope"
          },
          "scopeFallback": {
            "type": "boolean",
            "title": "Scopefallback",
            "description": "요청 범위를 못 지켜 TOTAL로 물러났는지"
          },
          "fallbackReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallbackreason"
          },
          "commitSha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commitsha"
          },
          "findings": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Findings"
          },
          "questionCountPlanned": {
            "type": "integer",
            "title": "Questioncountplanned",
            "description": "계획된 질문 수. 유효 DP가 적으면 축소된다"
          }
