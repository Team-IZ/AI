{
  "openapi": "3.1.0",
  "info": {
    "title": "IZ-GET",
    "description": "코드 분석 및 소크라틱 문답과 채점, 교안 분석 및 안내를 위한 AI 서비스",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "서비스 상태 확인",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/analyses": {
      "post": {
        "tags": [
          "analyses"
        ],
        "summary": "코드 분석 요청 (P02)",
        "description": "분석 요청 접수하고 즉시 202 반환. 실제 분석은 백그라운드\n\nx_trace_id는 아직 사용 X. 헤더 자리 게약 고정하고 Swagger 노출 위해 지금 받아둠\n- 로깅에 붙이는 것은 나중",
        "operationId": "create_analysis_api_v0_analyses_post",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "submissionId:attemptNo. 중복 요청 판별",
              "title": "Idempotency-Key"
            },
            "description": "submissionId:attemptNo. 중복 요청 판별"
          },
          {
            "name": "x-trace-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "분산 추적 ID",
              "title": "X-Trace-Id"
            },
            "description": "분산 추적 ID"
          },
          {
            "name": "x-internal-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Key"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisAccepted"
                }
              }
            }
          },
          "422": {
            "description": "요청 스키마 위반",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "description": "POST /api/v0/analyses 요청 본문 ",
                "properties": {
                  "attemptId": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Spring 측 측정수행 키(에코용)",
                    "title": "Attemptid"
                  },
                  "submissionId": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Submissionid"
                  },
                  "callbackUrl": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "완료 통지 수신 주소. 현재는 수용만 하고 전송은 미구현",
                    "title": "Callbackurl"
                  },
                  "method": {
                    "enum": [
                      "GITHUB_URL",
                      "ZIP_WITH_GITLOG"
                    ],
                    "title": "Method",
                    "type": "string"
                  },
                  "source": {
                    "properties": {
                      "repoUrl": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "method=GITHUB_URL일 때 필수. 공개 레포만 지원",
                        "title": "Repourl"
                      },
                      "branch": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "생략 시 기본 브랜치",
                        "title": "Branch"
                      }
                    },
                    "title": "AnalysisSource",
                    "type": "object"
                  },
                  "extractionScope": {
                    "default": "TOTAL",
                    "enum": [
                      "TOTAL",
                      "OWN_COMMIT"
                    ],
                    "title": "Extractionscope",
                    "type": "string"
                  },
                  "commitEmail": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "OWN_COMMIT일 때 필수",
                    "title": "Commitemail"
                  },
                  "questionBudget": {
                    "default": 4,
                    "description": "계획 질문 수",
                    "minimum": 1,
                    "title": "Questionbudget",
                    "type": "integer"
                  },
                  "focusAreas": {
                    "items": {
                      "type": "string"
                    },
                    "title": "Focusareas",
                    "type": "array"
                  }
                },
                "required": [
                  "method"
                ],
                "title": "AnalysisRequest",
                "type": "object"
              },
              "example": {
                "method": "GITHUB_URL",
                "source": {
                  "repoUrl": "https://github.com/owner/repo",
                  "branch": "main"
                },
                "extractionScope": "TOTAL",
                "questionBudget": 4
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "payload",
                  "file"
                ],
                "properties": {
                  "payload": {
                    "type": "string",
                    "description": "요청 JSON을 문자열로. method는 ZIP_WITH_GITLOG",
                    "example": "{\"method\":\"ZIP_WITH_GITLOG\",\"extractionScope\":\"TOTAL\"}"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "제출 ZIP"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/analyses/{job_id}": {
      "get": {
        "tags": [
          "analyses"
        ],
        "summary": "분석 상태·결과 조회 (P02)",
        "description": "분석 job의 현재 상태와 결과를 돌려준다.\n\n경로의 {job_id}가 함수 파라미터 job_id로 자동 연결된다. 이름이 같아야 한다.\n\njob 저장소가 인메모리라 프로세스가 재시작되면 404가 난다.\n그때는 Spring이 분석을 다시 요청하면 된다(FastAPI는 상태의 소유자가 아니다).",
        "operationId": "get_analysis_api_v0_analyses__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "x-internal-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisJobStatus"
                }
              }
            }
          },
          "404": {
            "description": "모르는 job_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
